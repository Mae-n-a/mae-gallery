---
import '../styles/global.css';
import { portfolio } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${portfolio.name} — ${portfolio.role}`,
  description = portfolio.metaDescription,
} = Astro.props;

const year = new Date().getFullYear();

// Cloudflare Web Analytics: paste the beacon token from the dashboard
// (Analytics & Logs → Web Analytics → your site → JS snippet → the "token").
// Leave empty to disable. Privacy-friendly + cookieless. Alternatively, since
// the site is Cloudflare-proxied, you can enable automatic setup in the
// dashboard with zero code and leave this blank.
const ANALYTICS_TOKEN = '';

// Absolute URL helper (falls back to the relative path if `site` is unset).
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.url ? abs(Astro.url.pathname) : undefined;
// Dedicated 1200×630 social share card (see public/assets/og.jpg).
const ogImage = abs('/assets/og.jpg');

// schema.org structured data: the artist, the site, and each artwork.
const personId = `${abs('/')}#mae`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: portfolio.name,
      alternateName: 'Maedeh Naderianvar',
      jobTitle: portfolio.role,
      description: portfolio.statement,
      image: abs(portfolio.photo),
      url: Astro.site ? abs('/') : undefined,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Turin',
        addressCountry: 'IT',
      },
      knowsAbout: ['Acrylic painting', 'Contemporary figurative art', 'Persian art'],
    },
    {
      '@type': 'WebSite',
      '@id': `${abs('/')}#website`,
      url: Astro.site ? abs('/') : undefined,
      name: title,
      inLanguage: 'en',
      about: { '@id': personId },
    },
    ...portfolio.collections.flatMap((c) =>
      c.works.map((w) => ({
        '@type': 'VisualArtwork',
        name: w.title,
        artform: 'Painting',
        artMedium: w.medium,
        dateCreated: w.year,
        image: abs(w.img),
        creator: { '@id': personId },
        isPartOf: c.title,
      }))
    ),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- schema.org structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Space+Grotesk:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <footer>
      <span>{portfolio.name} — {portfolio.role}</span>
      <span>© {year} · Turin</span>
    </footer>
    {ANALYTICS_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}
      />
    )}
  </body>
</html>
